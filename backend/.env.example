# ------------------------------------------------------------------
# GTH Backend - Variables de entorno
# Copia este archivo a `.env` y ajusta los valores.
# ------------------------------------------------------------------

# Servidor
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://gth:gth@localhost:5432/gth_hr?schema=public"

# Autenticación (JWT)
JWT_ACCESS_SECRET="cambia-esta-clave-de-acceso-super-secreta"
JWT_REFRESH_SECRET="cambia-esta-clave-de-refresh-super-secreta"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (origen del frontend)
CORS_ORIGIN=http://localhost:5173
