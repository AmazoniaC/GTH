# ------------------------------------------------------------------
# GTH Backend - Variables de entorno
# Copia este archivo a `.env` y ajusta los valores.
# ------------------------------------------------------------------

# Servidor
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://gth:gth@localhost:5432/gth_hr?schema=public"

# Autenticación (JWT)
JWT_ACCESS_SECRET="cambia-esta-clave-de-acceso-super-secreta"
JWT_REFRESH_SECRET="cambia-esta-clave-de-refresh-super-secreta"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (origen del frontend)
CORS_ORIGIN=http://localhost:5173

# Dueño(s) de la plataforma: correos que pueden gestionar TODAS las empresas
# (panel de plataforma: ver, activar/desactivar, eliminar y entrar como
# soporte). Separados por coma. Déjalo vacío para que nadie tenga ese acceso.
# Al arrancar, el servidor crea automáticamente una cuenta por cada correo
# que no exista aún (rol SUPER_ADMIN) usando PLATFORM_OWNER_PASSWORD.
PLATFORM_OWNER_EMAILS=

# Contraseña inicial de las cuentas de dueño de plataforma creadas
# automáticamente. Cámbiala en producción.
PLATFORM_OWNER_PASSWORD=Progrexa2026*
