// ------------------------------------------------------------------
// GTH - Gestión de Talento Humano
// Esquema de base de datos (PostgreSQL + Prisma)
//
// Diseñado de forma modular y preparado para multi-empresa (multi-tenant
// por columna `organizationId`). Actualmente incluye únicamente los
// módulos de Empleados y Nómina, pero la arquitectura permite añadir
// nuevos módulos (Vacaciones, Reclutamiento, etc.) sin refactorizar.
// ------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================================================================
// NÚCLEO / MULTI-EMPRESA
// ==================================================================

model Organization {
  id           String   @id @default(cuid())
  name         String
  nit          String   @unique
  legalName    String?
  address      String?
  city         String?
  phone        String?
  email        String?
  logoUrl      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users          User[]
  employees      Employee[]
  departments    Department[]
  positions      Position[]
  payrollPeriods PayrollPeriod[]
  payrollConfigs PayrollConfig[]
  catalogOptions CatalogOption[]
  auditLogs      AuditLog[]
  customFields   CustomFieldDefinition[]

  @@map("organizations")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  HR_MANAGER
  PAYROLL_MANAGER
  EMPLOYEE
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  password       String
  firstName      String
  lastName       String
  role           UserRole @default(HR_MANAGER)
  avatarUrl      String?
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee?

  @@index([organizationId])
  @@map("users")
}

// ==================================================================
// ESTRUCTURA ORGANIZACIONAL
// ==================================================================

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]
  positions    Position[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

model Position {
  id             String   @id @default(cuid())
  organizationId String
  departmentId   String?
  code           String? // Identificador legible del cargo (ej: CAR-001)
  title          String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees    Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("positions")
}

// ==================================================================
// MÓDULO: GESTIÓN DE EMPLEADOS
// ==================================================================

// Los tipos de documento y de contrato se gestionan como catálogos
// editables (modelo CatalogOption), por eso se almacenan como texto.

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  FREE_UNION
}

// El estado del empleado es un catálogo editable (EMPLOYEE_STATUS). El
// código "ACTIVE" es especial: la nómina liquida a los empleados activos.

enum PaymentFrequency {
  MONTHLY
  BIWEEKLY // Quincenal
}

// Catálogo de opciones configurables (tipos de documento, tipos de
// contrato, etiquetas de estado, etc.). Permite editar las listas
// seleccionables desde el módulo de Configuración sin tocar el código.
model CatalogOption {
  id             String   @id @default(cuid())
  organizationId String
  category       String // DOCUMENT_TYPE | CONTRACT_TYPE | EMPLOYEE_STATUS
  code           String
  label          String
  order          Int      @default(0)
  isSystem       Boolean  @default(false) // No se puede eliminar (afecta lógica)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, category, code])
  @@index([organizationId, category])
  @@map("catalog_options")
}

model Employee {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?  @unique

  // Identificación
  employeeCode   String
  documentType   String   @default("CC") // Catálogo editable DOCUMENT_TYPE
  documentNumber String
  issuePlace     String? // Lugar de expedición del documento
  issueDate      DateTime? // Fecha de expedición del documento

  // Datos personales
  firstName      String // Primer nombre
  middleName     String? // Segundo nombre
  lastName       String // Primer apellido
  secondLastName String? // Segundo apellido
  email          String?
  phone          String? // Teléfono fijo
  mobile         String? // Celular
  birthDate      DateTime?
  gender         Gender?
  maritalStatus  MaritalStatus?
  nationality    String? // Nacionalidad
  bloodType      String? // Grupo sanguíneo (O+, A-, etc.)
  address        String?
  city           String?
  stateProvince  String? // Departamento (geográfico)
  country        String? // País
  photoUrl       String?

  // Contacto de emergencia
  emergencyContactName  String?
  emergencyContactPhone String?

  // Organización
  departmentId   String?
  positionId     String?
  managerId      String? // Jefe directo (jerarquía)
  costCenter     String? // Centro de costo (catálogo COST_CENTER)
  workLocation   String? // Sede / centro de trabajo (catálogo WORK_LOCATION)
  hireDate       DateTime
  terminationDate DateTime?
  status         String   @default("ACTIVE") // Catálogo editable EMPLOYEE_STATUS

  // Seguridad social (Colombia)
  eps                 String? // Entidad Promotora de Salud
  pensionFund         String? // Administradora de Fondo de Pensiones (AFP)
  severanceFund       String? // Fondo de cesantías
  compensationFund    String? // Caja de compensación familiar
  arl                 String? // Administradora de Riesgos Laborales (entidad)
  arlRiskClass        Int     @default(1) // Nivel/clase de riesgo ARL (1-5)

  // Datos bancarios
  bankName       String?
  bankAccountType String? // Ahorros / Corriente
  bankAccountNumber String?

  // Campos personalizados (definidos por la empresa) — { clave: valor }
  customFields   Json?

  // Consentimiento de tratamiento de datos (Ley 1581 / Habeas Data)
  dataConsent    Boolean  @default(false)
  dataConsentAt  DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position     Position?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  manager      Employee?    @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports      Employee[]   @relation("EmployeeManager")
  contracts    Contract[]
  payslips     Payslip[]
  documents    EmployeeDocument[]
  salaryChanges SalaryChange[]
  dependents   Dependent[]
  educations   Education[]
  experiences  WorkExperience[]

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, documentNumber])
  @@index([organizationId])
  @@index([status])
  @@map("employees")
}

// Documentos adjuntos del empleado (contrato, cédula, hoja de vida, etc.).
// El contenido se guarda como data URL (base64). El tipo se controla con el
// catálogo editable FILE_TYPE.
model EmployeeDocument {
  id          String   @id @default(cuid())
  employeeId  String

  type        String // Código del catálogo FILE_TYPE
  name        String // Nombre/descripción visible
  fileName    String
  mimeType    String
  size        Int // Tamaño en bytes
  content     String // data URL base64

  issueDate   DateTime?
  expiryDate  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_documents")
}

// Formación académica (hoja de vida).
model Education {
  id          String   @id @default(cuid())
  employeeId  String
  level       String // Catálogo EDUCATION_LEVEL
  institution String
  title       String? // Título / programa
  startDate   DateTime?
  endDate     DateTime?
  isCompleted Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("educations")
}

// Experiencia laboral previa (hoja de vida).
model WorkExperience {
  id               String   @id @default(cuid())
  employeeId       String
  company          String
  position         String
  startDate        DateTime?
  endDate          DateTime?
  isCurrent        Boolean  @default(false)
  responsibilities String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("work_experiences")
}

// Definición de campos personalizados por empresa.
model CustomFieldDefinition {
  id             String   @id @default(cuid())
  organizationId String
  key            String // Clave estable (slug)
  label          String
  type           String // TEXT | NUMBER | DATE | BOOLEAN | SELECT
  options        Json? // Opciones para SELECT
  section        String   @default("Adicional")
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("custom_field_definitions")
}

// Grupo familiar / beneficiarios del empleado.
model Dependent {
  id             String   @id @default(cuid())
  employeeId     String

  relationship   String // Parentesco (catálogo RELATIONSHIP)
  firstName      String
  lastName       String
  documentType   String?
  documentNumber String?
  birthDate      DateTime?
  gender         Gender?
  isBeneficiary  Boolean  @default(true) // Beneficiario de prestaciones
  notes          String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("dependents")
}

// Bitácora de auditoría: registra creaciones, cambios y eliminaciones.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String

  userId         String?
  userName       String?
  action         String // CREATE | UPDATE | DELETE
  entity         String // Employee | Contract | SalaryChange | Document | Dependent | User
  entityId       String?
  entityLabel    String?
  changes        Json?

  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// Historial de cambios salariales (aumentos, ajustes) para trazabilidad.
model SalaryChange {
  id             String   @id @default(cuid())
  employeeId     String
  previousSalary Decimal  @db.Decimal(14, 2)
  newSalary      Decimal  @db.Decimal(14, 2)
  effectiveDate  DateTime
  reason         String?
  createdAt      DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("salary_changes")
}

model Contract {
  id             String   @id @default(cuid())
  employeeId     String

  type           String           @default("INDEFINITE") // Catálogo editable CONTRACT_TYPE
  paymentFrequency PaymentFrequency @default(MONTHLY)
  baseSalary     Decimal          @db.Decimal(14, 2)
  // ¿Salario integral? (Ley 50). Si es true no aplica factor prestacional aparte.
  isIntegralSalary Boolean        @default(false)
  // ¿Tiene derecho a auxilio de transporte? (normalmente <= 2 SMMLV)
  transportAllowance Boolean      @default(true)

  startDate      DateTime
  endDate        DateTime?
  probationEndDate DateTime? // Fin del periodo de prueba
  isActive       Boolean  @default(true)
  endReason      String? // Motivo de terminación (para el historial)
  notes          String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("contracts")
}

// ==================================================================
// MÓDULO: NÓMINA
// ==================================================================

// Parámetros legales configurables por año (SMMLV, auxilio de transporte,
// porcentajes de aportes, UVT, etc.). Permite adaptar la nómina a cambios
// de legislación sin tocar el código.
model PayrollConfig {
  id                    String   @id @default(cuid())
  organizationId        String
  year                  Int

  minimumWage           Decimal  @db.Decimal(14, 2) // SMMLV
  transportAllowance    Decimal  @db.Decimal(14, 2) // Auxilio de transporte
  uvt                   Decimal  @db.Decimal(14, 2) // Unidad de Valor Tributario

  // Porcentajes (expresados como fracción, ej: 0.04 = 4%)
  healthEmployeeRate    Decimal  @db.Decimal(6, 5) @default(0.04000)
  healthEmployerRate    Decimal  @db.Decimal(6, 5) @default(0.08500)
  pensionEmployeeRate   Decimal  @db.Decimal(6, 5) @default(0.04000)
  pensionEmployerRate   Decimal  @db.Decimal(6, 5) @default(0.12000)

  // Parafiscales
  senaRate              Decimal  @db.Decimal(6, 5) @default(0.02000)
  icbfRate              Decimal  @db.Decimal(6, 5) @default(0.03000)
  compensationFundRate  Decimal  @db.Decimal(6, 5) @default(0.04000)

  // Prestaciones sociales (provisiones)
  severanceRate         Decimal  @db.Decimal(6, 5) @default(0.08330) // Cesantías
  severanceInterestRate Decimal  @db.Decimal(6, 5) @default(0.01000) // Intereses cesantías (mensual)
  serviceBonusRate      Decimal  @db.Decimal(6, 5) @default(0.08330) // Prima de servicios
  vacationRate          Decimal  @db.Decimal(6, 5) @default(0.04170) // Vacaciones

  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, year])
  @@index([organizationId])
  @@map("payroll_configs")
}

enum PayrollPeriodType {
  MONTHLY
  BIWEEKLY_FIRST // 1ra quincena
  BIWEEKLY_SECOND // 2da quincena
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  APPROVED
  PAID
  CANCELLED
}

model PayrollPeriod {
  id             String   @id @default(cuid())
  organizationId String

  name           String // Ej: "Nómina Julio 2026"
  type           PayrollPeriodType @default(MONTHLY)
  year           Int
  month          Int
  startDate      DateTime
  endDate        DateTime
  paymentDate    DateTime?
  status         PayrollStatus @default(DRAFT)

  // Totales consolidados (denormalizados para reportes rápidos)
  totalEarnings  Decimal  @db.Decimal(16, 2) @default(0)
  totalDeductions Decimal @db.Decimal(16, 2) @default(0)
  totalNet       Decimal  @db.Decimal(16, 2) @default(0)
  totalEmployerCost Decimal @db.Decimal(16, 2) @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payslips     Payslip[]

  @@unique([organizationId, year, month, type])
  @@index([organizationId])
  @@map("payroll_periods")
}

model Payslip {
  id             String   @id @default(cuid())
  periodId       String
  employeeId     String

  workedDays     Int      @default(30)
  baseSalary     Decimal  @db.Decimal(14, 2)

  totalEarnings  Decimal  @db.Decimal(14, 2) @default(0)
  totalDeductions Decimal @db.Decimal(14, 2) @default(0)
  netPay         Decimal  @db.Decimal(14, 2) @default(0)
  employerCost   Decimal  @db.Decimal(14, 2) @default(0)

  status         PayrollStatus @default(DRAFT)
  notes          String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items    PayslipItem[]

  @@unique([periodId, employeeId])
  @@index([employeeId])
  @@map("payslips")
}

enum PayslipItemType {
  EARNING // Devengado
  DEDUCTION // Deducción
  EMPLOYER_COST // Costo/provisión del empleador (no afecta neto del empleado)
}

model PayslipItem {
  id          String   @id @default(cuid())
  payslipId   String

  type        PayslipItemType
  code        String   // Código interno (ej: SALARY, HEALTH_EMP, TRANSPORT)
  concept     String   // Descripción visible
  quantity    Decimal  @db.Decimal(10, 2) @default(1)
  amount      Decimal  @db.Decimal(14, 2)

  createdAt   DateTime @default(now())

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
  @@map("payslip_items")
}
